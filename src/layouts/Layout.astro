---
// Supports weights 100-900
import "@fontsource-variable/montserrat";

interface Props {
  title: string;
  description: string;
}
---

<!doctype html>
<html lang="es">
  <head>
    <title>Porfolio de Gluitx - Desarrollador y Programador Web</title>
    <meta
      name="title"
      content="Porfolio de Gluitx - Desarrollador y Programador Web"
    />
    <meta
      name="description"
      content="¡He lanzado mi nuevo portafolio! 🚀 Creado con Astro, no solo es un sitio web, es una experiencia ultrarrápida. Echa un vistazo a los proyectos y a la magia detrás del framework."
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="../../public/favicon.svg" />

    <meta property="og:url" content="https://glutix.github.io/porfolio/" />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Porfolio de Gluitx - Desarrollador y Programador Web"
    />
    <meta
      property="og:description"
      content="¡He lanzado mi nuevo portafolio! 🚀 Creado con Astro, no solo es un sitio web, es una experiencia ultrarrápida. Echa un vistazo a los proyectos y a la magia detrás del framework.
  
  #DesarrolloWeb #AstroJS #UXUI #Portfolio"
    />
    <meta property="og:image" content="https://i.imgur.com/0v0KYXO.jpeg" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="glutix.github.io" />
    <meta property="twitter:url" content="https://glutix.github.io/porfolio/" />
    <meta
      name="twitter:title"
      content="Porfolio de Gluitx - Desarrollador y Programador Web"
    />
    <meta
      name="twitter:description"
      content="¡He lanzado mi nuevo portafolio! 🚀 Creado con Astro, no solo es un sitio web, es una experiencia ultrarrápida. Echa un vistazo a los proyectos y a la magia detrás del framework.
  
  #DesarrolloWeb #AstroJS #UXUI #Portfolio"
    />
    <meta name="twitter:image" content="https://i.imgur.com/0v0KYXO.jpeg" />
    <link rel="preconnect" />
  </head>
  <body data-color-scheme="dark">
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Geist Pixel Square";
    src: url("/fonts/geist-pixel-square.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
  }

  :root {
    color-scheme: light dark;
  }

  [data-color-scheme="light"] {
    --primary-color: #ffffff;
    --secundary-color: #333;
    --secundary-color-variant: #5f5f5f;
    --btn-hover: #eab308;
    --text-title: #000000;
    --text-normal: #242422;
    --text-normal-variant: #fff;
    --text-enfasis: #24215f;
    --text-enfasis-1: #c0001a;
    --text-enfasis-2: #003580;
    --image-shadow: #eab308;

    --form-btn-text: #fff;
    --form-btn-backgroud: #333;
    --form-btn-hover: #eab308;
    --form-btn-disable: #5f5f5f;

    --form-input-bg: #fff;
    --form-input-bg-focus: #fff;

    /* ── Escena About ── */
    --scene-beam-start: rgba(20, 50, 120, 0.55);
    --scene-beam-mid: rgba(20, 50, 120, 0.22);
    --scene-beam-end: rgba(20, 50, 120, 0.03);
    --scene-spot: rgba(20, 50, 120, 0.28);
    --scene-rain: rgba(20, 50, 120, 0.5);
    --scene-bulb: #24215f;
    --scene-bulb-glow: rgba(20, 50, 120, 0.25);
  }

  [data-color-scheme="dark"] {
    --primary-color: #121212;
    --secundary-color: #3f3f3f;
    --secundary-color-variant: #12121293;
    --btn-hover: #5c5b5b;
    --text-title: #fff;
    --text-normal: #d7d7d7;
    --text-normal-variant: #d7d7d7;
    --text-enfasis: #f0e480;
    --text-enfasis-1: #ec829d;
    --text-enfasis-2: #b8d2ef;
    --image-shadow: #ffffff80;

    --form-btn-text: #000;
    --form-btn-backgroud: #f0e480;
    --form-btn-hover: #fded5b;
    --form-btn-disable: #f0e480;

    --form-input-text: #fff;
    --form-input-bg: #272727;
    --form-input-bg-focus: #3f3f3f;

    /* ── Escena About ── */
    --scene-beam-start: rgba(240, 240, 255, 0.45);
    --scene-beam-mid: rgba(240, 240, 255, 0.18);
    --scene-beam-end: rgba(240, 240, 255, 0.02);
    --scene-spot: rgba(240, 240, 255, 0.2);
    --scene-rain: rgba(200, 220, 255, 1);
    --scene-bulb: #f0f0ff;
    --scene-bulb-glow: rgba(240, 240, 255, 0.2);
  }

  html {
    font-family:
      "Geist Pixel Square", "Montserrat Variable", system-ui, sans-serif;
    scroll-behavior: smooth;
    background-color: var(--primary-color);

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      color: var(--text-title);
      text-wrap: balance;
    }

    h1 {
      font-size: 34px;
      line-height: 1.8;
      margin: 0;
    }

    h2 {
      font-size: 30px;
      line-height: 1.7;
      margin: 0;
    }

    h3 {
      font-size: 26px;
      line-height: 1.6;
      margin: 0;
    }

    p {
      text-wrap: pretty;
      font-size: 18px;
      line-height: 1.6;
    }
  }

  body {
    margin: 0;
    padding: 0;
    display: flex;
    box-sizing: border-box;
    flex-direction: column;
    position: relative;
    align-items: center;
    min-height: 100vh;
    overscroll-behavior: none;
    width: 100%;
    background-color: var(--primary-color);
    color: var(--text-normal);
    transition: all 1s ease;
  }
</style>
