---
import Sun from "../icons/Sun.astro";
import Moon from "../icons/Moon.astro";
---

<div class="container">
  <label class="toggle" for="switch" aria-label="Cambiar tema">
    <input id="switch" class="input" type="checkbox" />
    <div class="track">
      <div class="thumb">
        <span class="icon icon--sun"><Sun /></span>
        <span class="icon icon--moon"><Moon /></span>
      </div>
    </div>
  </label>
</div>

<style>
  .container {
    position: fixed;
    top: 1.5rem;
    right: 2rem;
    z-index: 10;
  }

  .toggle {
    display: flex;
    align-items: center;
    cursor: pointer;
    min-height: 44px;
  }

  .input {
    display: none;
  }

  /* ── Track (pill) ────────────────────────────────────────── */
  .track {
    position: relative;
    width: 68px;
    height: 34px;
    background: var(--toggle-track-bg);
    border: 1px solid var(--toggle-track-border);
    border-radius: 99px;
    transition:
      background 0.35s ease,
      border-color 0.35s ease;
    backdrop-filter: blur(6px);
  }

  /* ── Thumb (circle inside pill) ──────────────────────────── */
  .thumb {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 24px;
    height: 24px;
    background: var(--toggle-thumb-bg);
    border-radius: 50%;
    display: grid;
    place-items: center;
    box-shadow: 0 2px 8px var(--toggle-thumb-shadow);
    transition:
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      background 0.35s ease,
      box-shadow 0.35s ease;
  }

  /* Checked = light mode → thumb slides right */
  .input:checked ~ .track .thumb {
    transform: translateX(34px);
  }

  /* ── Icons ───────────────────────────────────────────────── */
  .icon {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--toggle-icon-color);
    transition:
      opacity 0.2s ease,
      transform 0.3s ease;
  }

  .icon :global(svg) {
    width: 14px;
    height: 14px;
  }

  /* Default (dark mode): show moon, hide sun */
  .icon--sun {
    opacity: 0;
    transform: scale(0.5) rotate(-90deg);
  }
  .icon--moon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  /* Checked (light mode): show sun, hide moon */
  .input:checked ~ .track .thumb .icon--sun {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
  .input:checked ~ .track .thumb .icon--moon {
    opacity: 0;
    transform: scale(0.5) rotate(90deg);
  }

  /* ── Hover glow ──────────────────────────────────────────── */
  .toggle:hover .track {
    border-color: var(--text-enfasis);
    box-shadow: 0 0 0 3px var(--toggle-thumb-shadow);
  }

  /* ── Tablet ──────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .container {
      top: 1rem;
      right: 1.25rem;
    }
  }

  /* ── Mobile ──────────────────────────────────────────────── */
  @media (max-width: 480px) {
    .container {
      top: 0.75rem;
      right: 0.75rem;
    }
  }

  /* ── Small mobile ────────────────────────────────────────── */
  @media (max-width: 390px) {
    .container {
      top: 0.6rem;
      right: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb,
    .icon {
      transition: none;
    }
  }
</style>

<script>
  const toggleInput = document.getElementById("switch") as HTMLInputElement;
  const body = document.body;

  function applyTheme(theme: string) {
    body.setAttribute("data-color-scheme", theme);
    localStorage.setItem("theme", theme);
    toggleInput.checked = theme === "light";
  }

  function getDefaultSystemTheme() {
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  }

  function setDefaultUserTheme() {
    const storedTheme = localStorage.getItem("theme");
    const systemTheme = getDefaultSystemTheme();
    applyTheme(storedTheme || systemTheme);
  }

  function handleToggle() {
    const newTheme = toggleInput.checked ? "light" : "dark";
    applyTheme(newTheme);
  }

  function handleSystemThemeChange(event: MediaQueryListEvent) {
    const newTheme = event.matches ? "dark" : "light";
    applyTheme(newTheme);
  }

  document.addEventListener("DOMContentLoaded", setDefaultUserTheme);
  toggleInput.addEventListener("change", handleToggle);
  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", handleSystemThemeChange);
</script>
