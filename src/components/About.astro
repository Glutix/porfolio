---
import SectionTitle from "./SectionTitle.astro";
import UserCheckbox from "../icons/UserCeck.astro";
import { Image } from "astro:assets";
import imagenAbout from "../assets/imagen-about.png";
---

<div id="about">
  <SectionTitle id="about" title="Sobre mi" icon={UserCheckbox} />
  <section>
    <article>
      <p>
        Soy <strong>Ricardo</strong>, también conocido como <strong
          >Glutix</strong
        >. Comencé en la programación en la universidad, donde descubrí en el
        <strong>desarrollo web y de software</strong> una forma de crear y resolver
        problemas.
      </p>
      <p>
        Participé en proyectos que fortalecieron mis habilidades técnicas y el
        <strong>trabajo en equipo</strong>, aprendiendo a encontrar soluciones
        simples a desafíos complejos.
      </p>
      <p>
        Hoy sigo explorando tecnologías para <strong
          >crear aplicaciones útiles e innovadoras</strong
        >, creciendo tanto en lo <strong>profesional</strong> como en lo personal.
      </p>
    </article>

    <div class="scene">
      <!-- SVG filters -->
      <svg width="0" height="0" style="position:absolute">
        <defs>
          <filter id="spotBlur">
            <feGaussianBlur stdDeviation="12"></feGaussianBlur>
          </filter>
          <filter id="bulbGlow">
            <feGaussianBlur stdDeviation="3" result="blur"></feGaussianBlur>
            <feMerge>
              <feMergeNode in="blur"></feMergeNode>
              <feMergeNode in="SourceGraphic"></feMergeNode>
            </feMerge>
          </filter>
          <linearGradient id="beamGrad" x1="0.5" y1="0" x2="0.5" y2="1">
            <stop offset="0%" class="beam-stop-start"></stop>
            <stop offset="45%" class="beam-stop-mid"></stop>
            <stop offset="100%" class="beam-stop-end"></stop>
          </linearGradient>
        </defs>
      </svg>

      <!-- Z=1: Cono de luz -->
      <svg
        class="svg-back"
        viewBox="0 0 460 540"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <polygon
          class="beam-poly"
          points="214,32 246,32 475,528 -15,528"
          fill="url(#beamGrad)"></polygon>
        <ellipse
          class="spot-ellipse"
          cx="230"
          cy="522"
          rx="245"
          ry="16"
          filter="url(#spotBlur)"></ellipse>
      </svg>

      <!-- Z=2: Imagen base -->
      <div class="image-wrapper">
        <Image class="image" src={imagenAbout} alt="imagen acerca de mi" />
      </div>

      <!-- Z=3: Reflejo -->
      <div class="image-wrapper image-wrapper--reflection">
        <Image class="image" src={imagenAbout} alt="" aria-hidden="true" />
      </div>

      <!-- Z=4: Canvas de lluvia -->
      <canvas class="rain-canvas" aria-hidden="true"></canvas>

      <!-- Z=5: Lámpara -->
      <svg
        class="svg-front"
        viewBox="0 0 460 540"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <line
          x1="460"
          y1="-20"
          x2="420"
          y2="-20"
          stroke="#888"
          stroke-width="2"
          stroke-linecap="round"></line>
        <circle cx="420" cy="-20" r="3.5" fill="#555"></circle>
        <line
          x1="420"
          y1="-20"
          x2="310"
          y2="-2"
          stroke="#666"
          stroke-width="4"
          stroke-linecap="round"></line>
        <circle cx="310" cy="-2" r="5" fill="#4a4a4a"></circle>
        <circle cx="310" cy="-2" r="3" fill="#333"></circle>
        <line
          x1="310"
          y1="-2"
          x2="230"
          y2="14"
          stroke="#666"
          stroke-width="4"
          stroke-linecap="round"></line>
        <circle cx="230" cy="14" r="4.5" fill="#4a4a4a"></circle>
        <polygon points="213,8 247,8 260,30 200,30" fill="#333"></polygon>
        <polygon points="215,10 245,10 257,28 203,28" fill="#222"></polygon>
        <line x1="200" y1="30" x2="260" y2="30" stroke="#555" stroke-width="1.2"
        ></line>
        <circle class="bulb-glow" cx="230" cy="20" r="8" filter="url(#bulbGlow)"
        ></circle>
        <circle class="bulb" cx="230" cy="20" r="4"></circle>
      </svg>
    </div>
  </section>
</div>

<script>
  const canvas = document.querySelector(".rain-canvas") as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext("2d");
    const W = 460;
    const H = 540;
    canvas.width = W;
    canvas.height = H;

    const DROP_COUNT = 120;

    const drops = Array.from({ length: DROP_COUNT }, () => ({
      x: Math.random() * W,
      y: Math.random() * H,
      length: 10 + Math.random() * 20,
      speed: 4 + Math.random() * 6,
      opacity: 0.08 + Math.random() * 0.18,
    }));

    const angle = Math.PI / 12;
    const dx = Math.sin(angle);
    const dy = Math.cos(angle);

    function getRainColor() {
      return getComputedStyle(document.body)
        .getPropertyValue("--scene-rain")
        .trim();
    }

    function draw() {
      if (!ctx) return;
      ctx.clearRect(0, 0, W, H);
      const rainBase = getRainColor();
      drops.forEach((d) => {
        ctx.beginPath();
        ctx.moveTo(d.x, d.y);
        ctx.lineTo(d.x + dx * d.length, d.y + dy * d.length);
        ctx.strokeStyle = rainBase.startsWith("rgba")
          ? rainBase.replace(/[\d.]+\)$/, `${d.opacity})`)
          : `rgba(180, 210, 255, ${d.opacity})`;
        ctx.lineWidth = 0.8;
        ctx.stroke();

        d.x += dx * d.speed;
        d.y += dy * d.speed;

        if (d.y > H + d.length) {
          d.x = Math.random() * W;
          d.y = -d.length;
        }
        if (d.x > W + d.length) {
          d.x = -d.length;
          d.y = Math.random() * H;
        }
      });
      requestAnimationFrame(draw);
    }

    draw();
  }
</script>

<style>
  div {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    min-height: 100dvh;
    height: fit-content;
    justify-content: center;
  }

  section {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  article {
    display: flex;
    flex-direction: column;
    flex: 1;
    max-width: 460px;
    padding-top: 50px;
    text-wrap: pretty;
  }

  p {
    color: var(--text-normal);
    line-height: 1.6;
  }

  strong {
    color: var(--text-enfasis);
  }

  .scene {
    position: relative;
    flex-shrink: 0;
    flex-grow: 0;
    width: 460px;
    height: 540px;
    min-height: unset !important;
    gap: 0;
    margin-top: -40px;
  }

  .svg-back {
    position: absolute;
    top: 0;
    left: 0;
    width: 460px;
    height: 540px;
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }

  .svg-front {
    position: absolute;
    top: 0;
    left: 0;
    width: 460px;
    height: 540px;
    pointer-events: none;
    z-index: 5;
    overflow: visible;
  }

  .rain-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 460px;
    height: 540px;
    pointer-events: none;
    z-index: 4;
    border-radius: 14px;
  }

  /* Bombilla — colores desde variables */
  .bulb {
    fill: var(--scene-bulb);
    animation: flickerBulb 5s steps(1, end) infinite;
  }
  .bulb-glow {
    fill: var(--scene-bulb-glow);
    animation: flickerBulb 5s steps(1, end) infinite;
  }
  .beam-poly,
  .spot-ellipse {
    animation: flickerBeam 5s steps(1, end) infinite;
  }

  /* Gradiente del cono via CSS variables */
  .beam-stop-start {
    stop-color: var(--scene-beam-start);
  }
  .beam-stop-mid {
    stop-color: var(--scene-beam-mid);
  }
  .beam-stop-end {
    stop-color: var(--scene-beam-end);
  }
  .spot-ellipse {
    fill: var(--scene-spot);
  }

  /* Imagen base */
  .image-wrapper {
    position: absolute;
    top: 140px;
    left: 70px;
    width: 340px;
    height: 460px;
    z-index: 2;
    min-height: unset !important;
    gap: 0;
  }

  .image {
    display: block;
    width: 320px;
    height: 460px;
    object-fit: cover;
    object-position: top center;
    border-radius: 14px;
  }

  /* Reflejo */
  .image-wrapper--reflection {
    clip-path: inset(0 0 0 55%);
    border-radius: 0 14px 14px 0;
    overflow: hidden;
    z-index: 3;
  }

  /* Ambas imágenes sincronizan con la lámpara */
  .image-wrapper .image {
    animation: flickerImagen 5s steps(1, end) infinite;
  }

  @keyframes flickerBulb {
    0% {
      opacity: 1;
    }
    8% {
      opacity: 0.05;
    }
    9% {
      opacity: 1;
    }
    21% {
      opacity: 0.05;
    }
    22% {
      opacity: 0.05;
    }
    23% {
      opacity: 1;
    }
    51% {
      opacity: 0.05;
    }
    52% {
      opacity: 1;
    }
    53% {
      opacity: 0.05;
    }
    54% {
      opacity: 1;
    }
    73% {
      opacity: 0.05;
    }
    74% {
      opacity: 0.05;
    }
    75% {
      opacity: 1;
    }
    96% {
      opacity: 0.05;
    }
    97% {
      opacity: 1;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes flickerBeam {
    0% {
      opacity: 1;
    }
    8% {
      opacity: 0;
    }
    9% {
      opacity: 1;
    }
    21% {
      opacity: 0;
    }
    22% {
      opacity: 0;
    }
    23% {
      opacity: 1;
    }
    51% {
      opacity: 0;
    }
    52% {
      opacity: 1;
    }
    53% {
      opacity: 0;
    }
    54% {
      opacity: 1;
    }
    73% {
      opacity: 0;
    }
    74% {
      opacity: 0;
    }
    75% {
      opacity: 1;
    }
    96% {
      opacity: 0;
    }
    97% {
      opacity: 1;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes flickerImagen {
    0% {
      opacity: 1;
    }
    8% {
      opacity: 0;
    }
    9% {
      opacity: 1;
    }
    21% {
      opacity: 0;
    }
    22% {
      opacity: 0;
    }
    23% {
      opacity: 1;
    }
    51% {
      opacity: 0;
    }
    52% {
      opacity: 1;
    }
    53% {
      opacity: 0;
    }
    54% {
      opacity: 1;
    }
    73% {
      opacity: 0;
    }
    74% {
      opacity: 0;
    }
    75% {
      opacity: 1;
    }
    96% {
      opacity: 0;
    }
    97% {
      opacity: 1;
    }
    100% {
      opacity: 1;
    }
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 1000px) {
    section {
      flex-direction: column-reverse;
      justify-content: center;
      align-items: center;
    }

    article {
      padding-top: 0;
    }

    .scene {
      width: 300px;
      height: 352px;
      align-self: center;
      margin-top: 0;
    }

    .svg-back,
    .svg-front {
      width: 300px;
      height: 352px;
    }
    .rain-canvas {
      width: 300px;
      height: 352px;
    }

    .image-wrapper {
      top: 80px;
      left: 40px;
      width: 220px;
      height: 300px;
    }

    .image {
      width: 220px;
      height: 300px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bulb,
    .bulb-glow,
    .beam-poly,
    .spot-ellipse,
    .image-wrapper .image {
      animation: none;
    }
  }
</style>
