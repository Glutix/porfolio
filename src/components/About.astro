---
import SectionTitle from "./SectionTitle.astro";
import UserCheckbox from "../icons/UserCeck.astro";
import { Image } from "astro:assets";
import imagenAbout from "../assets/imagen-about.jpg";
---

<div id="about">
  <SectionTitle id="about" title="Sobre mi" icon={UserCheckbox} />
  <section>
<article>
  <p>
    Soy <strong>Ricardo</strong>, también conocido como <strong>Glutix</strong>. 
    Comencé en la programación en la universidad, donde descubrí en el 
    <strong>desarrollo web y de software</strong> una forma de crear y resolver problemas.
  </p>
  <p>
    Participé en proyectos que fortalecieron mis habilidades técnicas y el 
    <strong>trabajo en equipo</strong>, aprendiendo a encontrar soluciones simples a desafíos complejos.
  </p>
  <p>
    Hoy sigo explorando tecnologías para <strong>crear aplicaciones útiles e innovadoras</strong>, 
    creciendo tanto en lo <strong>profesional</strong> como en lo personal.
  </p>
</article>

    <div class="scene">
      <!-- Z=1: Cono de luz -->
      <svg
        class="svg-back"
        viewBox="0 0 460 540"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <defs>
          <filter id="spotBlur">
            <feGaussianBlur stdDeviation="12"></feGaussianBlur>
          </filter>
          <linearGradient id="beamGrad" x1="0.5" y1="0" x2="0.5" y2="1">
            <stop offset="0%" stop-color="rgba(255,252,190,0.45)"></stop>
            <stop offset="45%" stop-color="rgba(255,252,190,0.18)"></stop>
            <stop offset="100%" stop-color="rgba(255,252,190,0.02)"></stop>
          </linearGradient>
        </defs>
        <!--
          Lámpara reducida: pantalla termina en y=32 (antes y=44)
          Boca del cono: x=284..336 (52px), y=32 — pegada a la pantalla
          Centro: x=310
          Base: x=60..560 (500px) centrada en x=310 → 310±250
          overflow:visible renderiza lo que sale del viewBox ✓

          Verificación imagen (220px, x=200..420, top=y=160):
            cono(160) = 52 + 448*(160-32)/508 = 52+113 = 165px → semi=82 → x=228..392
            imagen x=200..420 → esquinas fuera ✗
          
          top imagen sube a y=200:
            cono(200) = 52 + 448*168/508 = 52+148 = 200px → semi=100 → x=210..410
            imagen x=200..420 → 10px fuera derecha ✗

          top=210: cono(210) = 52+448*178/508 = 52+157 = 209px → semi=104 → x=206..414
          imagen x=200..420 → 6px fuera ✗

          imagen 210px: top=210, left=205 (310-105)
            cono(210)=209 < 210 ✗ por 1px...

          imagen 200px centrada: x=210..410, top=200
            cono(200)=200px → semi=100 → x=210..410 → exacto ✓✓
            cono(520)=500px → semi=250 → x=60..560 — imagen bien dentro ✓
        -->
        <polygon
          class="beam-poly"
          points="284,32 336,32 560,528 60,528"
          fill="url(#beamGrad)"></polygon>
        <ellipse
          class="spot-ellipse"
          cx="310"
          cy="522"
          rx="245"
          ry="16"
          fill="rgba(255,252,190,0.20)"
          filter="url(#spotBlur)"></ellipse>
      </svg>

      <!-- Z=2: Imagen -->
      <div class="image-wrapper">
        <Image class="image" src={imagenAbout} alt="imagen acerca de mi" />
        <div class="flicker-light" aria-hidden="true"></div>
        <div class="flicker-overlay" aria-hidden="true"></div>
      </div>

      <!-- Z=3: Lámpara más pequeña, foco en x=310 y=32 -->
      <svg
        class="svg-front"
        viewBox="0 0 460 540"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <defs>
          <filter id="bulbGlow">
            <feGaussianBlur stdDeviation="3" result="blur"></feGaussianBlur>
            <feMerge>
              <feMergeNode in="blur"></feMergeNode>
              <feMergeNode in="SourceGraphic"></feMergeNode>
            </feMerge>
          </filter>
        </defs>

        <!--
          Todo escalado ~0.7x respecto a antes:
          Cable: entra desde x=460, y=-20 → x=420
          Codo 1: 420,-20 → 385,-2
          Codo 2: 385,-2  → 310,14
          Pantalla: centrada en x=310, borde inferior y=32
        -->
        <line
          x1="460"
          y1="-20"
          x2="420"
          y2="-20"
          stroke="#888"
          stroke-width="2"
          stroke-linecap="round"></line>
        <circle cx="420" cy="-20" r="3.5" fill="#555"></circle>

        <line
          x1="420"
          y1="-20"
          x2="385"
          y2="-2"
          stroke="#666"
          stroke-width="4"
          stroke-linecap="round"></line>
        <circle cx="385" cy="-2" r="5" fill="#4a4a4a"></circle>
        <circle cx="385" cy="-2" r="3" fill="#333"></circle>

        <line
          x1="385"
          y1="-2"
          x2="310"
          y2="14"
          stroke="#666"
          stroke-width="4"
          stroke-linecap="round"></line>
        <circle cx="310" cy="14" r="4.5" fill="#4a4a4a"></circle>

        <!-- Pantalla reducida centrada en x=310, borde inferior y=32 -->
        <polygon points="293,8 327,8 340,30 280,30" fill="#333"></polygon>
        <polygon points="295,10 325,10 337,28 283,28" fill="#222"></polygon>
        <line x1="280" y1="30" x2="340" y2="30" stroke="#555" stroke-width="1.2"
        ></line>

        <!-- Bulbo -->
        <circle
          class="bulb-glow"
          cx="310"
          cy="20"
          r="8"
          fill="rgba(255,255,220,0.15)"
          filter="url(#bulbGlow)"></circle>
        <circle class="bulb" cx="310" cy="20" r="4" fill="#fffff0"></circle>
      </svg>
    </div>
  </section>
</div>

<style>
  div {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
    min-height: 100dvh;
    height: fit-content;
    justify-content: center;
  }

  section {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;

    article {
      display: flex;
      flex-direction: column;
      p {
        color: var(--text-normal);
        text-wrap: pretty;
        padding-right: 1rem;
      }
      strong {
        color: var(--text-enfasis);
      }
    }
  }

  .scene {
    position: relative;
    flex-shrink: 0;
    align-self: flex-start;
    width: 460px;
    height: 540px;
    min-height: unset !important;
    gap: 0;
  }

  .svg-back {
    position: absolute;
    top: 0;
    left: 0;
    width: 460px;
    height: 540px;
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }

  .svg-front {
    position: absolute;
    top: 0;
    left: 0;
    width: 460px;
    height: 540px;
    pointer-events: none;
    z-index: 3;
    overflow: visible;
  }

  .bulb {
    animation: flickerBulb 5s steps(1, end) infinite;
  }
  .bulb-glow {
    animation: flickerBulb 5s steps(1, end) infinite;
  }
  .beam-poly,
  .spot-ellipse {
    animation: flickerBeam 5s steps(1, end) infinite;
  }

  /*
    imagen 200px centrada en x=310 → left = 310 - 100 = 210px
    top=200px: el cono mide exactamente 200px de ancho aquí → imagen justo dentro
  */
  .image-wrapper {
    position: absolute;
    top: 200px;
    left: 210px;
    width: 200px;
    height: 320px;
    border-radius: 14px;
    overflow: hidden;
    transform: none;
    z-index: 2;
    min-height: unset !important;
    gap: 0;
  }

  .image {
    display: block;
    width: 200px;
    height: 320px;
    object-fit: cover;
    object-position: top center;
  }

  .flicker-light {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: radial-gradient(
      ellipse 140% 70% at 50% 0%,
      rgba(255, 252, 190, 0.5) 0%,
      rgba(255, 252, 190, 0.22) 40%,
      rgba(255, 252, 190, 0.05) 65%,
      transparent 85%
    );
    animation: flickerLight 5s steps(1, end) infinite;
  }

  .flicker-overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    animation: flickerDark 5s steps(1, end) infinite;
  }

  @keyframes flickerBulb {
    0% {
      opacity: 1;
    }
    8% {
      opacity: 0.05;
    }
    9% {
      opacity: 1;
    }
    21% {
      opacity: 0.05;
    }
    22% {
      opacity: 0.05;
    }
    23% {
      opacity: 1;
    }
    51% {
      opacity: 0.05;
    }
    52% {
      opacity: 1;
    }
    53% {
      opacity: 0.05;
    }
    54% {
      opacity: 1;
    }
    73% {
      opacity: 0.05;
    }
    74% {
      opacity: 0.05;
    }
    75% {
      opacity: 1;
    }
    96% {
      opacity: 0.05;
    }
    97% {
      opacity: 1;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes flickerBeam {
    0% {
      opacity: 1;
    }
    8% {
      opacity: 0;
    }
    9% {
      opacity: 1;
    }
    21% {
      opacity: 0;
    }
    22% {
      opacity: 0;
    }
    23% {
      opacity: 1;
    }
    51% {
      opacity: 0;
    }
    52% {
      opacity: 1;
    }
    53% {
      opacity: 0;
    }
    54% {
      opacity: 1;
    }
    73% {
      opacity: 0;
    }
    74% {
      opacity: 0;
    }
    75% {
      opacity: 1;
    }
    96% {
      opacity: 0;
    }
    97% {
      opacity: 1;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes flickerLight {
    0% {
      opacity: 1;
    }
    8% {
      opacity: 0;
    }
    9% {
      opacity: 1;
    }
    21% {
      opacity: 0;
    }
    22% {
      opacity: 0;
    }
    23% {
      opacity: 1;
    }
    51% {
      opacity: 0;
    }
    52% {
      opacity: 1;
    }
    53% {
      opacity: 0;
    }
    54% {
      opacity: 1;
    }
    73% {
      opacity: 0;
    }
    74% {
      opacity: 0;
    }
    75% {
      opacity: 1;
    }
    96% {
      opacity: 0;
    }
    97% {
      opacity: 1;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes flickerDark {
    0% {
      background: rgba(0, 0, 0, 0);
    }
    8% {
      background: rgba(0, 0, 0, 0.55);
    }
    9% {
      background: rgba(0, 0, 0, 0);
    }
    21% {
      background: rgba(0, 0, 0, 0.65);
    }
    22% {
      background: rgba(0, 0, 0, 0.7);
    }
    23% {
      background: rgba(0, 0, 0, 0);
    }
    51% {
      background: rgba(0, 0, 0, 0.5);
    }
    52% {
      background: rgba(0, 0, 0, 0);
    }
    53% {
      background: rgba(0, 0, 0, 0.6);
    }
    54% {
      background: rgba(0, 0, 0, 0);
    }
    73% {
      background: rgba(0, 0, 0, 0.75);
    }
    74% {
      background: rgba(0, 0, 0, 0.8);
    }
    75% {
      background: rgba(0, 0, 0, 0);
    }
    96% {
      background: rgba(0, 0, 0, 0.55);
    }
    97% {
      background: rgba(0, 0, 0, 0);
    }
    100% {
      background: rgba(0, 0, 0, 0);
    }
  }

  /* ── Responsive — factor 460→300 = 0.652 ─────────────────── */
  @media (max-width: 1000px) {
    section {
      flex-direction: column-reverse;
      justify-content: center;
      align-items: center;
    }

    .scene {
      width: 300px;
      height: 352px; /* 540 * 0.652 */
      align-self: center;
    }

    .svg-back,
    .svg-front {
      width: 300px;
      height: 352px;
    }

    .image-wrapper {
      top: 130px; /* 200 * 0.652 */
      left: 137px; /* 210 * 0.652 */
      width: 130px; /* 200 * 0.652 */
      height: 209px; /* 320 * 0.652 */
    }

    .image {
      width: 130px;
      height: 209px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bulb,
    .bulb-glow,
    .beam-poly,
    .spot-ellipse,
    .flicker-light,
    .flicker-overlay {
      animation: none;
    }
  }
</style>
