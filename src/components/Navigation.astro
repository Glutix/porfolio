<nav class="nav">
  <a href="#home" class="active">Inicio</a>
  <a href="#projects">Proyectos</a>
  <a href="#about">Sobre mi</a>
  <a href="#contact">Contacto</a>

  <span class="nav-indicator"></span>
</nav>

<!-- Botón hamburguesa — solo visible en móvil -->
<button class="hamburger" aria-label="Abrir menú" aria-expanded="false">
  <span></span>
  <span></span>
  <span></span>
</button>

<!-- Menú móvil desplegable -->
<div class="mobile-menu" aria-hidden="true">
  <a href="#home" class="mobile-link active">Inicio</a>
  <a href="#projects" class="mobile-link">Proyectos</a>
  <a href="#about" class="mobile-link">Sobre mi</a>
  <a href="#contact" class="mobile-link">Contacto</a>
</div>

<style>
  /* ═══════════════════════════════════════════════
     NAV DESKTOP
  ═══════════════════════════════════════════════ */
  .nav {
    position: fixed;
    top: 1.5rem;
    left: 50%;
    transform: translateX(-50%);

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 0.25rem;
    padding: 3px;

    height: 34px;
    border-radius: 999px;

    background: var(--nav-bg);
    backdrop-filter: var(--nav-blur);
    -webkit-backdrop-filter: var(--nav-blur);

    border: 1px solid var(--nav-border);

    box-shadow:
      0 8px 32px var(--nav-shadow),
      0 2px 8px var(--nav-shadow),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);

    z-index: 100;

    transition:
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease,
      opacity 0.3s ease;
  }

  .nav.hidden {
    transform: translateX(-50%) translateY(-120%);
    opacity: 0;
    pointer-events: none;
  }

  .nav:hover {
    box-shadow:
      0 12px 40px var(--nav-shadow),
      0 0 0 1px var(--nav-border),
      inset 0 1px 0 var(--nav-inset);
  }

  .nav a {
    position: relative;
    z-index: 2;

    text-decoration: none;
    color: var(--nav-text-muted);

    padding: 4px 12px;
    border-radius: 999px;

    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 0.01em;

    transition:
      color 0.25s ease,
      transform 0.2s ease;

    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav a:hover {
    color: var(--nav-text);
  }

  .nav a.active {
    color: var(--nav-accent);
  }

  .nav a.active::after {
    content: "";
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--nav-accent);
    opacity: 0.5;
  }

  .nav-indicator {
    position: absolute;

    height: 68%;
    border-radius: 999px;

    background: var(--nav-active-bg);
    border: 1px solid var(--nav-border);

    top: 50%;
    transform: translateY(-50%);

    z-index: 1;

    box-shadow: 0 0 12px var(--nav-accent-soft);

    opacity: 0;
    transition:
      left 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease;
  }

  .nav-indicator.ready {
    opacity: 1;
  }

  /* ═══════════════════════════════════════════════
     HAMBURGUESA & MENÚ MÓVIL DESPLEGABLE
  ═══════════════════════════════════════════════ */
  .hamburger {
    display: none;
    position: fixed;
    top: 1.3rem;
    left: 2rem;
    z-index: 200;

    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;

    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--nav-border);
    background: var(--nav-bg);
    backdrop-filter: var(--nav-blur);
    -webkit-backdrop-filter: var(--nav-blur);
    cursor: pointer;
    padding: 0;

    box-shadow:
      0 8px 32px var(--nav-shadow),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);

    transition: box-shadow 0.3s ease;
  }

  .hamburger:hover {
    box-shadow:
      0 12px 40px var(--nav-shadow),
      0 0 0 1px var(--nav-border);
  }

  .hamburger span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--nav-text);
    border-radius: 999px;
    transform-origin: center;
    transition:
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s ease,
      width 0.3s ease;
  }

  /* Animación a X cuando está abierto */
  .hamburger.open span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .hamburger.open span:nth-child(2) {
    opacity: 0;
    width: 0;
  }
  .hamburger.open span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* ═══════════════════════════════════════════════
     MENÚ MÓVIL DESPLEGABLE
  ═══════════════════════════════════════════════ */
  .mobile-menu {
    display: flex;
    pointer-events: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 150;

    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;

    padding: 5rem 1.5rem 2rem;

    background: var(--nav-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--nav-border);

    transform: translateY(-100%);
    opacity: 0;
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s ease;
  }

  .mobile-menu.open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-link {
    text-decoration: none;
    color: var(--nav-text-muted);
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 0.75rem 2rem;
    border-radius: 999px;
    width: 100%;
    text-align: center;

    border: 1px solid transparent;
    transition:
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .mobile-link:hover {
    color: var(--nav-text);
    background: var(--nav-hover-bg);
    border-color: var(--nav-border);
  }

  .mobile-link.active {
    color: var(--nav-accent);
    background: var(--nav-active-bg);
    border-color: var(--nav-border);
  }

  /* ═══════════════════════════════════════════════
     RESPONSIVE BREAKPOINTS
  ═══════════════════════════════════════════════ */
  @media (max-width: 768px) {
    .nav {
      gap: 0.125rem;
      padding: 3px;
    }
    .nav a {
      padding: 4px 10px;
      font-size: 0.78rem;
    }
  }

  /* A partir de 480px: ocultar nav pill, mostrar hamburguesa */
  @media (max-width: 480px) {
    .nav {
      display: none;
    }

    .hamburger {
      display: flex;
      top: 1rem;
      left: 1.25rem;
    }
  }

  @media (max-width: 390px) {
    .hamburger {
      top: 0.75rem;
      left: 0.75rem;
    }
  }
</style>

<script>
  function initNav() {
    const nav = document.querySelector(".nav") as HTMLElement | null;
    const hamburger = document.querySelector(
      ".hamburger",
    ) as HTMLElement | null;
    const mobileMenu = document.querySelector(
      ".mobile-menu",
    ) as HTMLElement | null;
    const mobileLinks = Array.from(
      document.querySelectorAll(".mobile-link"),
    ) as HTMLElement[];

    if (!nav) return;

    const links = Array.from(nav.querySelectorAll("a")) as HTMLElement[];
    const indicator = nav.querySelector(".nav-indicator") as HTMLElement | null;

    const SECTION_IDS = ["home", "projects", "about", "contact"];

    // ── Hamburguesa ──────────────────────────────────────────────────
    function closeMenu() {
      hamburger?.classList.remove("open");
      mobileMenu?.classList.remove("open");
      hamburger?.setAttribute("aria-expanded", "false");
      mobileMenu?.setAttribute("aria-hidden", "true");
    }

    hamburger?.addEventListener("click", () => {
      const isOpen = hamburger.classList.toggle("open");
      mobileMenu?.classList.toggle("open", isOpen);
      hamburger.setAttribute("aria-expanded", String(isOpen));
      mobileMenu?.setAttribute("aria-hidden", String(!isOpen));
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const href = link.getAttribute("href");
        if (!href) return;

        const target = document.querySelector(href) as HTMLElement | null;
        if (target)
          target.scrollIntoView({ behavior: "smooth", block: "start" });

        mobileLinks.forEach((l) => l.classList.remove("active"));
        link.classList.add("active");

        const desktopLink = nav.querySelector(
          `a[href="${href}"]`,
        ) as HTMLElement | null;
        if (desktopLink) {
          links.forEach((l) => l.classList.remove("active"));
          desktopLink.classList.add("active");
          updateIndicator(desktopLink);
        }

        closeMenu();
      });
    });

    // ── Indicador ────────────────────────────────────────────────────
    function updateIndicator(el: HTMLElement) {
      if (!indicator) return;
      const rect = el.getBoundingClientRect();
      const navRect = nav!.getBoundingClientRect();
      indicator.style.width = rect.width + "px";
      indicator.style.left = rect.left - navRect.left + "px";
    }

    function setActive(id: string) {
      const target = nav!.querySelector(
        `a[href="#${id}"]`,
      ) as HTMLElement | null;
      if (target && !target.classList.contains("active")) {
        links.forEach((l) => l.classList.remove("active"));
        target.classList.add("active");
        updateIndicator(target);
      }

      mobileLinks.forEach((l) => {
        l.classList.toggle("active", l.getAttribute("href") === `#${id}`);
      });
    }

    // ── Posicionamiento inicial ──────────────────────────────────────
    function positionInitialIndicator() {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          const active = nav!.querySelector(".active") as HTMLElement | null;
          if (active) {
            updateIndicator(active);
            indicator?.classList.add("ready");
          }
        });
      });
    }

    if (document.fonts?.ready) {
      document.fonts.ready.then(positionInitialIndicator);
    } else {
      positionInitialIndicator();
    }

    // ── Clicks desktop ───────────────────────────────────────────────
    links.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const href = link.getAttribute("href");
        if (!href) return;

        const target = document.querySelector(href) as HTMLElement | null;
        if (target)
          target.scrollIntoView({ behavior: "smooth", block: "start" });

        setActive(href.replace("#", ""));
      });
    });

    // ── Resize ───────────────────────────────────────────────────────
    window.addEventListener("resize", () => {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          const active = nav!.querySelector(".active") as HTMLElement | null;
          if (active) updateIndicator(active);
          if (window.innerWidth > 480) closeMenu();
        });
      });
    });

    // ── Auto-hide al scroll hacia abajo (solo desktop) ───────────────
    let lastScrollY = window.scrollY;
    window.addEventListener(
      "scroll",
      () => {
        const y = window.scrollY;
        if (window.innerWidth > 480) {
          nav.classList.toggle("hidden", y > lastScrollY && y > 80);
        }
        lastScrollY = y;
      },
      { passive: true },
    );

    // ── Detección de sección activa ──────────────────────────────────
    function getSections(): HTMLElement[] {
      return SECTION_IDS.map((id) => document.getElementById(id)).filter(
        (el): el is HTMLElement => el !== null,
      );
    }

    function getActiveSectionId(): string | null {
      const sections = getSections();
      if (sections.length === 0) return null;

      const windowH = window.innerHeight;
      const docH = document.documentElement.scrollHeight;
      const NAV_OFFSET = 64;

      if (window.scrollY + windowH >= docH - 20) {
        return sections[sections.length - 1].id;
      }

      let bestId: string | null = null;
      let bestArea = 0;

      for (const el of sections) {
        const rect = el.getBoundingClientRect();
        const top = Math.max(rect.top, NAV_OFFSET);
        const bottom = Math.min(rect.bottom, windowH);
        const visible = Math.max(0, bottom - top);

        if (visible > bestArea) {
          bestArea = visible;
          bestId = el.id;
        }
      }

      return bestId;
    }

    let rafPending = false;
    function onScroll() {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(() => {
        const id = getActiveSectionId();
        if (id) setActive(id);
        rafPending = false;
      });
    }

    window.addEventListener("scroll", onScroll, { passive: true });

    onScroll();
    setTimeout(onScroll, 300);
  }

  document.addEventListener("astro:page-load", initNav);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initNav);
  } else {
    initNav();
  }
</script>
